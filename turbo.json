{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "V31M4_EXECUTION_PROFILE",
    "V31M4_OLLAMA_ENDPOINT",
    "V31M4_OLLAMA_MODEL",
    "V31M4_ROUTING_MODELS",
    "V31M4_RUN_REAL_MODEL_ROUTING",
    "V31M4_STAGE4_REAL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    }
  }
}
